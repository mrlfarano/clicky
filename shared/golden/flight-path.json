      "input": { "operation": "sample", "start": { "x": 100, "y": 200 }, "end": { "x": 400, "y": 200 }, "linearProgress": 0.75 },
      "expected": { "x": 353.125, "y": 184.1796875, "rotationDegrees": 105.37625124882618, "scale": 1.2121320343559643 }
