      "input": { "operation": "sample", "start": { "x": 100, "y": 200 }, "end": { "x": 400, "y": 200 }, "linearProgress": 0.5 },
      "expected": { "x": 250, "y": 170, "rotationDegrees": 90, "scale": 1.3 }
