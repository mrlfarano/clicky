{
  "schema": 1,
  "seam": "session-reducer",
  "swiftAnchor": "leanring-buddy/CompanionManager.swift:430-726",
  "description": "Seam 6. Each case starts from CompanionSessionState.Initial (plus input.initialHistory when present) and feeds input.events to CompanionSession.Reduce in order. Event types: shortcutPressed, shortcutReleased, recordingStarted, transcriptFinal {text}, responseReady {requestId, text}, ttsStarted, ttsEnded. expected.voiceStates and expected.effects have one entry per event (the state after it, and the effects it emitted, in order); expected.history is the conversation history after the last event. Effects are written as 'dismissPanel', 'cancelChatRequest <id>', 'stopTtsPlayback', 'clearPointingTarget', 'startRecording', 'stopRecording', 'startChatRequest <id> history=<count>', 'pointAtElement <x>,<y> <label>', 'speakResponse <text>' and 'analytics <event name>[: <content>]'. Parity spec PTT-02, PTT-03, CLA-07, AN-02.",
  "cases": [
    {
      "id": "full-exchange-with-point",
      "branch": "exchange-with-pointing",
      "swiftAnchor": "leanring-buddy/CompanionManager.swift:473-536, 586-724",
      "input": {
        "events": [
          { "type": "shortcutPressed" },
          { "type": "recordingStarted" },
          { "type": "shortcutReleased" },
          { "type": "transcriptFinal", "text": " where is save " },
          { "type": "responseReady", "requestId": 1, "text": "click the save button. [POINT:100,200:save button]" },
          { "type": "ttsStarted" },
          { "type": "ttsEnded" }
        ]
      },
      "expected": {
        "voiceStates": ["processing", "listening", "processing", "processing", "idle", "responding", "idle"],
        "effects": [
          ["dismissPanel", "stopTtsPlayback", "clearPointingTarget", "analytics push_to_talk_started", "startRecording"],
          [],
          ["analytics push_to_talk_released", "stopRecording"],
          ["analytics user_message_sent: where is save", "startChatRequest 1 history=0"],
          [
            "pointAtElement 100,200 save button",
            "analytics element_pointed: save button",
            "analytics ai_response_received: click the save button.",
            "speakResponse click the save button."
          ],
          [],
          []
        ],
        "history": [
          { "userTranscript": "where is save", "assistantResponse": "click the save button." }
        ]
      }
    },
