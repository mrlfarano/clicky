      "swiftAnchor": "leanring-buddy/CompanionManager.swift:473-536, 586-724",
      "input": {
        "events": [
          { "type": "shortcutPressed" },
          { "type": "recordingStarted" },
          { "type": "shortcutReleased" },
          { "type": "transcriptFinal", "text": " where is save " },
          { "type": "responseReady", "requestId": 1, "text": "click the save button. [POINT:100,200:save button]" },
          { "type": "ttsStarted" },
          { "type": "ttsEnded" }
        ]
      },
      "expected": {
        "voiceStates": ["processing", "listening", "processing", "processing", "idle", "responding", "idle"],
        "effects": [
          ["dismissPanel", "stopTtsPlayback", "clearPointingTarget", "analytics push_to_talk_started", "startRecording"],
          [],
          ["analytics push_to_talk_released", "stopRecording"],
          ["analytics user_message_sent: where is save", "startChatRequest 1 history=0"],
          [
            "pointAtElement 100,200 save button",
            "analytics element_pointed: save button",
            "analytics ai_response_received: click the save button.",
            "speakResponse click the save button."
          ],
          [],
          []
        ],
        "history": [
          { "userTranscript": "where is save", "assistantResponse": "click the save button." }
        ]
      }
    },
